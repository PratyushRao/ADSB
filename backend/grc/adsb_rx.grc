- name: epy_block_0
  id: epy_block
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      """
      ADS-B PPM Demodulator (1090 MHz Mode-S)

      Input: |IQ| magnitude at 2 Msps.
      Detects Mode-S preambles, slices PPM bits (phase-tracking + Viterbi
      fallback), checks CRC-24 (fixes 1-bit errors) and prints valid frames
      as *HEX; lines. Valid frames are also published as PDUs on "frames".

      This wraps AdsbPpmDemod from backend/dsp_demod.py, so GRC and the web
      backend run exactly the same DSP code. Edit the DSP there, not here.
      """
      import os
      import sys

      # Find backend/dsp_demod.py: next to the generated script (../), via
      # ADSB_BACKEND_DIR, or relative to where GRC was launched.
      _here = os.path.dirname(os.path.abspath(globals().get("__file__", os.path.join(os.getcwd(), "x"))))
      for _p in (os.environ.get("ADSB_BACKEND_DIR"), os.path.join(_here, ".."), os.path.join(os.getcwd(), "..")):
          if _p and os.path.isfile(os.path.join(_p, "dsp_demod.py")):
              _p = os.path.abspath(_p)
              if _p not in sys.path:
                  sys.path.insert(0, _p)
              break

      import dsp_demod


      class blk(dsp_demod.AdsbPpmDemod):
          """ADS-B PPM Demod: preamble detect, bit slicing, CRC-24 check."""

          def __init__(self, min_snr_db=8.0, print_frames=True):
              dsp_demod.AdsbPpmDemod.__init__(
                  self, sample_rate=2e6, min_snr_db=min_snr_db,
                  on_frame=self._print_frame if print_frames else None)

          def _print_frame(self, hexmsg, ts, rssi_db):
              print(f"*{hexmsg};   {rssi_db:6.1f} dBFS", flush=True)
    min_snr_db: '8.0'
    print_frames: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1320, 120]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters: {affinity: '', alias: '', comment: '', maxoutbuf: '0', minoutbuf: '0', type: float, name: '"Mode-S pulses |IQ| (triggered on preamble)"', ylabel: Amplitude, yunit: '""', size: '300', srate: samp_rate,
    grid: 'True', autoscale: 'True', ymin: '0', ymax: '1', nconnections: '1', update_time: '0.10', entags: 'False', gui_hint: '', tr_mode: qtgui.TRIG_MODE_NORM, tr_slope: qtgui.TRIG_SLOPE_POS, tr_level: '0.15',
    tr_delay: 5e-6, tr_chan: '0', tr_tag: '""', ctrlpanel: 'True', legend: 'False', label1: '|IQ|', width1: '1', color1: '"blue"', style1: '1', marker1: '-1', alpha1: '1.0'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1320, 240]
    rotation: 0
    state: enabled
